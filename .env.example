# job-watchdog reads these from the environment. None of them is a secret.
# The CLI does not load .env files itself; export them or use your scheduler's env block.

# SQLite file holding the runs and alerts tables.
WATCHDOG_DB=watchdog.db

# Job registry (copy jobs.example.json to jobs.json and edit).
WATCHDOG_JOBS=jobs.json

# Where alerts go: "console" prints one line per alert, "mock" appends JSON lines to a file.
WATCHDOG_ALERT_CHANNEL=mock
WATCHDOG_ALERT_LOG=alerts.jsonl
